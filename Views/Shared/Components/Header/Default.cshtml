@model MeCunMeo.ViewModels.HeaderViewModel
@using Microsoft.AspNetCore.Identity
@using MeCunMeo.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!-- Topbar Start -->
<div class="top-bar">
    <!--số điện thoại bên trái-->
    <div class="top-bar-left">
        <span>+077 889 9001</span>
    </div>
    <!--thông báo ở giữa-->
    <div class="top-bar-center">
        <span>Miễn phí vận chuyển cho đơn hàng trên 500.000đ!</span>
    </div>
    <!--icon mạng xã hội bên phải-->
    <div class="top-bar-right">
        <a href="#" class="social-item"><i class="fa-brands fa-facebook"></i></a>
        <a href="#" class="social-item"><i class="fa-brands fa-tiktok"></i></a>
        <a href="#" class="social-item"><i class="fa-brands fa-instagram"></i></a>
    </div>
</div>
<!-- Topbar End -->

<!-- Navbar Start -->
<nav class="navbar navbar-expand-lg bg-white navbar-light shadow-sm py-3 sticky-top">
    <!--Nút menu trên điện thoại-->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
        <span class="navbar-toggler-icon"></span>
    </button>
    
    <a asp-controller="Home" asp-action="Index" class="navbar-brand">
        <!-- Thêm dấu ~ để lấy ảnh từ wwwroot -->
        <img src="~/img/logo.png" alt="Mê Cún Mèo" class="img-fluid">   
    </a>

    <div class="collapse navbar-collapse" id="navbarCollapse">
        <div class="navbar-nav mx-auto">
            
            <!-- CODE MỚI: DROPDOWN CHO CÚN (Giữ class nav-item nav-link nhưng bọc thêm dropdown) -->
            <div class="nav-item dropdown">
                <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Cho Cún</a>
                <div class="dropdown-menu m-0">
                    @foreach (var cat in Model.CategoriesDog)
                    {
                        <!-- Link tới trang danh mục -->
                        <a asp-controller="Product" asp-action="Category" asp-route-id="@cat.Id" class="dropdown-item">@cat.Name</a>
                    }
                </div>
            </div>

            <!-- CODE MỚI: DROPDOWN CHO MÈO -->
            <div class="nav-item dropdown">
                <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Cho Mèo</a>
                <div class="dropdown-menu m-0">
                    @foreach (var cat in Model.CategoriesCat)
                    {
                        <a asp-controller="Product" asp-action="Category" asp-route-id="@cat.Id" class="dropdown-item">@cat.Name</a>
                    }
                </div>
            </div>

            <!-- Các link tĩnh giữ nguyên -->
            <a asp-controller="Home" asp-action="About" class="nav-item nav-link">Giới thiệu</a>
            <a asp-controller="Home" asp-action="Contact" class="nav-item nav-link">Liên hệ</a>
            <a asp-controller="Blog" asp-action="Index" class="nav-item nav-link">Blog</a>
        </div>

        <!-- navbar-icons -->
        <div class="navbar-icons d-flex align-items-center position-relative">
            <!-- Search Icon: Giữ nguyên onclick -->
            <span class="icon-link" style="cursor: pointer;" onclick="openSearch()">
                <i class="fa-solid fa-magnifying-glass"></i>
            </span>

            <!-- Giỏ hàng: Logic hiển thị Badge -->
            @if (SignInManager.IsSignedIn(User))
    {
        <!-- Đã đăng nhập: Vào trang Cart/Index -->
        <a asp-controller="Cart" asp-action="Index" class="icon-link position-relative">
            <i class="fa-solid fa-cart-shopping"></i>
            @if(Model.CartItemCount > 0)
            {
                <span class="badge-cart">@Model.CartItemCount</span>
            }
        </a>
    }
    else
    {
        <!-- Chưa đăng nhập: Đá về trang Login -->
        <a asp-area="Identity" asp-page="/Account/Login" class="icon-link">
            <i class="fa-solid fa-cart-shopping"></i>
        </a>
    }

    <!-- 3. USER: Xử lý Dropdown 2 trường hợp -->
    <div class="nav-item dropdown d-inline-block">
        
        <!-- Icon User (Luôn hiện icon, bấm vào xổ menu) -->
        <a href="#" class="icon-link dropdown-toggle" data-bs-toggle="dropdown">
            @if (SignInManager.IsSignedIn(User))
            {
                <i class="fa-solid fa-user-check text-success"></i> <!-- Icon xanh nếu đã login -->
            }
            else
            {
                <i class="fa-solid fa-user"></i> <!-- Icon thường nếu chưa login -->
            }
        </a>

        <!-- Menu xổ xuống -->
        <div class="dropdown-menu m-0">
            
            @if (SignInManager.IsSignedIn(User))
            {
                // --- TRƯỜNG HỢP 1: ĐÃ ĐĂNG NHẬP ---
                // Hiển thị tên, avatar (tượng trưng), menu chức năng
                <div class="px-3 py-2 border-bottom">
                    <div class="fw-bold">@UserManager.GetUserName(User)</div>
                    <small class="text-muted">Thành viên</small>
                </div>
                
                <a asp-controller="Account" asp-action="Index" class="dropdown-item py-2">
                    <i class="fa-solid fa-id-card me-2"></i> Hồ sơ cá nhân
                </a>
                <a asp-controller="Order" asp-action="Index" class="dropdown-item py-2">
                    <i class="fa-solid fa-box-open me-2"></i> Đơn mua
                </a>
                
                <div class="dropdown-divider"></div>
                
                <!-- Nút Đăng xuất -->
                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="dropdown-item text-danger py-2">
                        <i class="fa-solid fa-right-from-bracket me-2"></i> Đăng xuất
                    </button>
                </form>
            }
            else
            {
                // --- TRƯỜNG HỢP 2: CHƯA ĐĂNG NHẬP ---
                // Hiển thị Đăng nhập / Đăng ký
                <a asp-area="Identity" asp-page="/Account/Login" class="dropdown-item py-2">
                    <i class="fa-solid fa-right-to-bracket me-2"></i> Đăng nhập
                </a>
                <a asp-area="Identity" asp-page="/Account/Register" class="dropdown-item py-2">
                    <i class="fa-solid fa-user-plus me-2"></i> Đăng ký
                </a>
            }
            </div>
        </div>
    </div>
</nav>
<!-- Navbar End -->

<!-- Search Overlay Start (Giữ nguyên ID và Class của bạn) -->
<div id="full-search-overlay" class="search-overlay-container">
    <div class="overlay-backdrop" onclick="closeSearch()"></div>
    <div class="container py-4 position-relative" style="z-index: 10001;">
        
        <!-- Dòng nhập liệu -->
        <div class="search-header d-flex align-items-center border-bottom pb-3 mb-4">
            <i class="fa-solid fa-magnifying-glass fs-4 text-success me-3" style="color: #768862 !important;"></i>
            <!-- Thêm form để Enter là search -->
            <form asp-controller="Product" asp-action="Search" method="get" class="w-100 d-flex">
                <input type="text" name="keyword" id="main-search-input" 
                    class="form-control border-0 fs-3 bg-transparent shadow-none" 
                    placeholder="Tìm kiếm sản phẩm/bài viết...">
            </form>
            <!-- Sửa lại cái onclick của nút đóng -->
<button type="button" class="btn-close-overlay" onclick="closeSearch()">
    <i class="fa-solid fa-xmark"></i>
</button>
        </div>

        <!-- Nội dung gợi ý -->
        <div class="row">
            <!-- Từ khóa phổ biến (Lấy từ Danh mục Cún làm ví dụ) -->
            <div class="col-lg-3 border-end">
                <h6 class="fw-bold mb-3" style="letter-spacing: 1px; color: #563333;">Danh mục phổ biến</h6>
                <ul class="list-unstyled search-links">
                    @foreach(var cat in Model.CategoriesDog.Take(5))
                    {
                        <li><a asp-controller="Product" asp-action="Category" asp-route-id="@cat.Id">@cat.Name</a></li>
                    }
                </ul>
            </div>

            <!-- Sản phẩm bán chạy (Lấy từ Database) -->
            <div class="col-lg-9 ps-lg-5">
                <h6 class="fw-bold mb-3" style="letter-spacing: 1px; color: #563333;">Sản phẩm bán chạy</h6>
                <div class="row g-4">
                    
                    @if(Model.TopSellingProducts != null && Model.TopSellingProducts.Any())
                    {
                        @foreach(var item in Model.TopSellingProducts)
                        {
                            <div class="col-md-4">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                                    <div class="search-product-card position-relative">
                                        <!-- Ảnh sản phẩm -->
                                        <img src="~/img/products/@item.Image" class="img-fluid" style="width: 100%; height: auto;">
                                        <div class="mt-2">
                                            <span class="search-brand">@item.Brand</span>
                                            <span class="search-title">@item.Name</span>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End Search Overlay -->