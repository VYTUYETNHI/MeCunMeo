<head>
    <!-- ... -->
    
    <!-- Thêm dấu ~/ vào trước các đường dẫn -->
    <link href="~/img/favicon.ico" rel="icon">

    <!-- Dán dòng này vào trong thẻ <head> của file _Layout.cshtml -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    
    <!-- Libraries Stylesheet -->
    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="~/css/trangchu.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">
    <link href="~/css/thesanpham.css" rel="stylesheet">
    <!-- ... các thẻ meta, link css cũ giữ nguyên ... -->

    <!-- CHÈN ĐOẠN NÀY VÀO CUỐI THẺ HEAD -->
    <style>
        /* 1. XÓA TAM GIÁC (MŨI TÊN) DROPDOWN */
        .dropdown-toggle::after {
            content: none !important;
            display: none !important;
            border: none !important;
        }

        /* 2. ÉP SEARCH OVERLAY HIỆN HÌNH */
        /* Nếu không có đoạn này, overlay dù có display:block vẫn có thể bị trong suốt hoặc height=0 */
        #full-search-overlay {
            position: fixed !important;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: rgba(255, 255, 255, 0.98) !important; /* Màu trắng đục che hết web */
            z-index: 99999 !important; /* Luôn nằm trên cùng */
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s ease-in-out, visibility 0.3s ease-in-out;
            overflow-y: auto;
        }

        #full-search-overlay.open {
            opacity: 1;
            visibility: visible;
        }
    </style>
</head>
<body>
    <!-- Gọi ViewComponent Header -->
    @await Component.InvokeAsync("Header")

    @RenderBody()
    
    <!-- Footer Partial vẫn dùng PartialView bình thường nếu nó ít logic -->
    <partial name="_FooterPartialView" />
    

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    
    <!-- QUAN TRỌNG: Phải có dòng này thì Menu Dropdown mới chạy -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Script riêng của bạn (xử lý Search, Slider...) -->
    <script src="~/js/main.js"></script>
    
    <!-- Script xử lý Search Overlay (Thêm đoạn này vào cuối file Layout luôn cho tiện) -->
    <script>

         // 1. Mở tìm kiếm
    function openSearch() {
        const overlay = document.getElementById('full-search-overlay');
        overlay.classList.add('open');
        setTimeout(() => {
            document.getElementById('main-search-input').focus();
        }, 300);
    }

    // 2. Đóng tìm kiếm
    function closeSearch() {
        document.getElementById('full-search-overlay').classList.remove('open');
    }

    // 2. Hàm xử lý khi bấm phím ENTER 
    function searchOnEnter(event) {
        if (event.keyCode === 13 || event.key === 'Enter') {
            var keyword = document.getElementById('main-search-input').value;
            if (keyword.trim() !== "") {
                // Chuyển sang trang timkiem.html kèm từ khóa
                window.location.href = "timkiem.html?keyword=" + encodeURIComponent(keyword);
            } else {
                // Nếu chưa nhập thì chỉ chuyển trang thôi
                window.location.href = "timkiem.html";
            }
        }
    }
         
         $(document).ready(function () {
            $('.dropdown-toggle').dropdown();
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>